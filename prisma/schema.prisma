// ============================================================
// schema.prisma - نسخه نهایی با Industry و Activity
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ============================================================
// لایه هسته (Core)
// ============================================================
// ============================================================
// نقش‌های سیستمی (سطح کاربر)
// ============================================================
enum SystemRole {
  system_admin         // مدیر سیستم
  system_user          // کاربر عادی (پیش‌فرض)
}

// ============================================================
// نقش‌های سطح بازار (Arm)
// ============================================================
enum ArmRole {
  arm_owner            // مالک بازار (معادل مدیر بازار)
  arm_seller           // فروشنده در این بازار
  arm_buyer            // خریدار در این بازار
  arm_member           // عضو عادی (بدون نقش خاص)
}

// ============================================================
// نقش‌های سطح کاتالوگ (Catalog)
// ============================================================
enum CatalogRole {
  catalog_owner       // مالک کاتالوگ (مدیریت کامل)
  catalog_admin       // مدیر کاتالوگ (دسترسی‌های مدیریتی به جز انتقال مالکیت)
  catalog_seller      // کاربر با دسترسی فقط مشاهده (پیش‌فرض)
}
model VerificationCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  code      String
  type      String   @default("password_reset") // password_reset, phone_verification
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([code])
  @@index([expiresAt])
}


model User {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  phone           String    @unique
  passwordHash    String
  fullName        String?
  // ── فیلدهای جدید پروفایل شخصی ──
  referralCode     String?   @unique              // کد دعوت خودکار
  referredByUserId String?   @db.ObjectId         // first-touch: فقط بار اول پر می‌شود
  referredAt       DateTime?
  referredBy       User?     @relation("ReferralTree", fields: [referredByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  referrals        User[]    @relation("ReferralTree")
  email           String?
  gender          String?
  birthDate       DateTime?
  province        String?
  country         String?
  city            String?
  countryCode     String?
  provinceCode    String?
  cityCode        String?
  postalCode      String?
  address         String?
  bio             String?
  website         String?
  telegram        String?
  socialLinks     Json?

  avatarUrl       String?
  status          String    @default("member")
  locale          String    @default("fa")
  timezone        String    @default("Asia/Tehran")
  role            SystemRole @default(system_user)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?
  membershipTier  String    @default("free")
  isPhoneVerified Boolean   @default(false)
  phoneVerifiedAt DateTime?
  temporaryPassword Boolean @default(true)
  nationalId      String?
  teamMemberships TeamMember[]
  ads             Ad[]            @relation("AdCreator")
  callEvents      CallEvent[]
  files           File[]
  creditRequests  CreditRequest[]
  armsOwned       Arm[]           @relation("ArmOwner")
  armMemberships  ArmMembership[]
  credits         Credit[]
  adInteractions  AdInteraction[]
  buyLeads        BuyLead[]
  feedbacks       Feedback[]
  searchLogs      SearchLog[]
  catalogInteractions CatalogInteraction[]
  businesses      Business[]   @relation("BizOwner")
  @@index([status])
  @@index([role])
  @@index([isPhoneVerified])
}


// ============================================================
// لایه نهاد تجاری (Business) — برگرفته از مدل قدیمی؛ بدون slug و بدون رلیشن‌های سنگین
// verification/trust: فیلدها خفته — فلوی فعلی روی Catalog است؛ فاز بعد به اینجا منتقل می‌شود
// ============================================================
model Business {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerUserId        String   @db.ObjectId
  owner              User     @relation("BizOwner", fields: [ownerUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name               String
  shortDescription   String?
  type               String   @default("wholesaler")
  description        String?
  countryCode        String?  @default("98")
  province           String?
  provinceCode       String?
  city               String?
  cityCode           String?
  address            String?
  phone              String?
  website            String?
  logoUrl            String?
  nationalId         String?
  businessLicense    String?
  verificationTier   String   @default("none")      // مرجعِ تیک — ادمین اینجا می‌نویسد
  verificationStatus String   @default("none")
  trustScore         Float    @default(0)
  businessStartYear  Int?                           // ✅ از User منتقل شد
  status             String   @default("active")
  industryName       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  armMemberships     ArmMembership[] @relation("BizArmMembership")
  catalogs           Catalog[]          @relation("BusinessCatalogs")
  verifications      Verification[]     @relation("BusinessVerification")
  activities         BusinessActivity[] @relation("BusinessActivity")   // ✅ از Catalog برگشت

  @@index([ownerUserId])
  @@index([type])
}
model Catalog {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  referredByCode     String?
  referredByUserId   String?   @db.ObjectId
  name               String
  shortDescription   String?
  slug               String?
  isFeatured         Boolean   @default(false)
  salesType          String    @default("wholesale")
  config             Json?
  featuredUntil      DateTime?
  type               String
  description        String?
  countryCode        String?   @default("98")
  city               String?
  cityCode           String?
  province           String?
  provinceCode       String?
  address            String?
  phone              String
  website            String?
  logoUrl            String?
  status             String    @default("active")
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  files            File[]
  teamMembers      TeamMember[]
  ads              Ad[]
  armMemberships   ArmMembership[]
  credits          Credit[]
  trustMetrics     TrustMetric[]
  buyLeads         BuyLead[]
  creditRequests   CreditRequest[]
  catalogInteractions CatalogInteraction[]

  businessId    String    @db.ObjectId
  business      Business  @relation("BusinessCatalogs", fields: [businessId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  industryName  String?

  @@index([type])
  @@index([slug], map: "Catalog_slug_idx")
  @@index([businessId])
}

// ============================================================
// لایه تایید (Verification)
// ============================================================

model Verification {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  businessId        String   @db.ObjectId
  business          Business @relation("BusinessVerification", fields: [businessId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tier              String
  status            String   @default("pending")
  documents         Json?
  notes             String?
  submittedAt       DateTime @default(now())
  reviewedAt        DateTime?
  reviewedByUserId  String?  @db.ObjectId
  expiresAt         DateTime?
  metadata          Json?

  @@index([businessId, status])
}
model TeamMember {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  catalogId   String   @db.ObjectId
  catalog     Catalog @relation(fields: [catalogId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role         CatalogRole  @default(catalog_seller)
  position     String?
  permissions  Json?
  invitedBy    String?  @db.ObjectId
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([catalogId, userId])
  @@index([catalogId])
  @@index([userId])
}

// ============================================================
// لایه موقعیت جغرافیایی (Location)
// ============================================================

model Location {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String     @unique
  parentId    String?    @db.ObjectId
  parent      Location?  @relation("LocationTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Location[] @relation("LocationTree")
  level       Int        @default(0)
  path        String
  type        String     @default("country") // country | province | city | district
  countryCode String?
  provinceCode String?
  cityCode    String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([path])
  @@index([parentId])
  @@index([type])
  @@unique([type, countryCode, provinceCode, cityCode])
}

// ============================================================
// لایه درخت کالا (ProductCategory)
// ============================================================

model ProductCategory {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  code               String    @unique
  parentCode         String?
  title              String
  titleEn            String?
  slug               String    @unique
  parentId           String?   @db.ObjectId
  parent             ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children           ProductCategory[] @relation("CategoryTree")
  level              Int       @default(0)
  path               String
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  defaultUnitId      String?   @db.ObjectId
  defaultMinQuantity Float?
  example            String?
  icon               String?
  description        String?
  customFieldsSchema Json?
  score              Int       @default(0)


  @@index([parentId])
  @@index([path])
  @@index([level])
}

model Unit {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String   @unique
  shortCode   String   @unique
  isDefault   Boolean  @default(false)
  // ✅ جدید — برای واحدهای بسته‌بندی: تعداد واحد خرد داخلش (مثلاً ۲۴ پفک در کارتن)
  containsQty Int?     // null = واحد استاندارد (کیلوگرم، متر...) — فیلد نمایش داده نمی‌شود
  qtyIsFixed  Boolean  @default(false) // true = تعداد ثابت است و کاربر نمی‌تواند تغییر دهد
  adUnits     Ad[]
}


// ============================================================
// لایه بازار (Arm) - با Config JSON
// ============================================================

model Arm {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  slug                String    // @unique حذف شده
  name                String
  shortName           String?
  slogan              String
  description         String?
  icon                String?
  colorPrimary        String?
  colorSecondary      String?
  logoUrl             String?
  bannerUrl           String?
  mission             String?
  status              String    @default("draft")
  visibility          String    @default("public")
  ownerUserId         String    @db.ObjectId
  owner               User      @relation("ArmOwner", fields: [ownerUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  geoScopeType        String
  defaultUnitId       String?   @db.ObjectId
  featuresEnabled     String[]  @default([])
  rankingAlgorithm    String    @default("simple")
  metadata            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  launchedAt          DateTime?
 customDomain         String?   // برای راه اندازی روی دومین اختصاصی "barton.com"
  categoryTree       Json?
  allowedCategoryScopeTree Json?
  config              Json?
  memberships         ArmMembership[]
  ads                 Ad[]
  adPublications      AdPublication[] @relation("ArmAdPublications")
  buyLeads            BuyLead[]
  credits             Credit[]
  trustMetrics        TrustMetric[]
  files               File[]
  creditRequests      CreditRequest[]
  searchLogs SearchLog[]
  feedbacks Feedback[]
  @@unique([slug])
  @@index([status])
}

// ============================================================
// پیوستن به بازار
// ============================================================

// ============================================================
// پیوستن به بازار — دو-مرحله‌ای:
//   userId     → انسانِ عضو (دیدن، سرچ، تماس، خرید = حقوق خریدار)
//   businessId → کلاهِ کاری عضویت (کسب‌وکارِ خریدار، یا نهادِ کاتالوگِ فروشنده)
//   catalogId  → مجوز نوشتن (فقط فروشنده — کاتالوگی که روی تابلو اجازهٔ انتشار دارد)
// ============================================================
model ArmMembership {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  armId            String   @db.ObjectId
  arm              Arm      @relation(fields: [armId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId           String   @db.ObjectId
  user             User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  publishState     String?  // 'published' | 'paused' | null — وضعیت انتشار کاتالوگ در بازار

  // ✅ businessId برای seller و buyer اجباری است، اما arm_owner می‌تواند null باشد
  // (مالک بازار نماینده کسب‌وکار نیست — خود بازار مال اوست)
  businessId       String?  @db.ObjectId
  business         Business? @relation("BizArmMembership", fields: [businessId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  catalogId        String?  @db.ObjectId
  catalog          Catalog? @relation(fields: [catalogId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role             ArmRole  @default(arm_member)
  permissionLevel  Int      @default(1)
  // ✅ status = وضعیت سیستمی (دسترسی به پنل ادمین)
  //    فقط: active | banned | removed
  //    arm_owner که active هست، همیشه به پنل دسترسی داره
  //    حتی اگه business نقشش pause بشه، status سیستمی active می‌مونه
  status           String   @default("active")
  // ✅ businessStatus = وضعیت تجاری (seller/buyer)
  //    فقط: active | paused
  //    اگه paused باشه، آگهی‌ها از تابلو غیب می‌شن (seller)
  //    یا حق دیدن قیمت‌ها رو از دست می‌ده (buyer)
  //    ولی دسترسی به پنل ادمین حفظ می‌شه (چون status سیستمی active هست)
  businessStatus   String   @default("active")
  source           String?  // auto_create | manual | invitation | owner_add
  metadata         Json?
  joinedAt         DateTime @default(now())
  updatedAt        DateTime @updatedAt
  // ✅ roleType نقش تجاری است (seller | buyer | seller-buyer | null)
  roleType         String?  // seller | buyer | seller-buyer
  rejectionReason  String?
  reviewedByUserId String?  @db.ObjectId
  reviewedAt       DateTime?

  // ✅ یک کاربر در یک بازار فقط یک membership دارد
  // این membership می‌تواند همزمان arm_owner و seller/buyer هم باشد
  // (در همون رکورد businessId/catalogId/roleType ست می‌شود)
  @@unique([armId, userId])

  // ✅ ایندکس‌ها برای query سریع
  @@index([userId])
  @@index([catalogId])
  @@index([businessId])
  @@index([armId, status])
  @@index([armId, roleType])
}




// ============================================================
// آگهی — عرضهٔ یک کالا/قیمت
//   catalogId          → کاتالوگ مالک (الزامی)
//   catalogCategoryId  → دسته در درختِ خصوصیِ کاتالوگ (همیشه پر؛ از فرم ثبت کالا)
//   categoryId/categoryPath → دسته روی تابلوی بازار — اختیاری؛ فقط هنگام
//                        مهرِ انتشار (stampCatalogAds) پر می‌شود. null = بی‌دسته در بازار
//                        (کاربر باید از داشبورد یا مالک بازار از پنل تعیین کند)
//   armId              → مهر انتشار؛ null = فقط در کاتالوگ نمایش داده می‌شود
// ============================================================
model Ad {
    id                    String    @id @default(auto()) @map("_id") @db.ObjectId
    armId                 String?   @db.ObjectId
    publishToMarket       Boolean   @default(true)   // نمایش در تابلوی بازار (کاتالوگ همیشه نشان می‌دهد)

    catalogCategoryId     String?   // گره در درختِ خصوصیِ کاتالوگ
    categoryId            String?   // ✅ دسته روی تابلوی بازار — اختیاری؛ هنگام انتشار پر می‌شود
    categoryPath          String[]  @default([])     // ✅ مسیر کامل دستهٔ بازاری (فیلتر + سئو)

    giftPrice             Float?
    volumeTiers           Json?

    arm                   Arm?      @relation(fields: [armId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    catalogId             String    @db.ObjectId
    catalog               Catalog   @relation(fields: [catalogId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    createdByUserId       String    @db.ObjectId
    createdBy             User      @relation("AdCreator", fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

    unitId                String    @db.ObjectId
    unit                  Unit      @relation(fields: [unitId], references: [id])
    unitQty               Int?      // تعداد در واحد، مثلا 12 عدد در کارتن
    unitIsVariableQty     Boolean   @default(false)
    unitBaseTitle         String?

    title                 String
    productType           String?
    description           String?
    unitPrice             Float
    singleUnitPrice       Float?
    consumerPrice         Float?
    minQuantity           Float
    priceHistory          Json?
    availableQuantity     Float?
    availableQuantityBucket String?

    countryCode           String?   @default("IR")
    provinceCode          String?
    cityCode              String?
    city                  String?
    province              String?
    locationDetail        String?
    geo                   Json?

    validityHours         Int       @default(24)
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt
    expiresAt             DateTime
    lastBumpedAt          DateTime?
    status                String    @default("active")
    isAnonymous           Boolean   @default(false)
    anonymousLabel        String?
    bumpCount             Int       @default(0)
    lastBumpCreditsSpent  Int       @default(0)
    isBumped              Boolean   @default(false)
    bumpExpiresAt         DateTime?
    bumpDurationHours     Int?
    trustScoreAtPost      Float?
    paymentMethods        Json?
    specs                 Json?
    customFields          Json?
    source                String    @default("manual")
    sourceMetadata        Json?
    viewCount             Int       @default(0)
    callCount             Int       @default(0)
    metadata              Json?
    rejectionReason       String?

    files                 File[]
    views                 AdView[]
    callEvents            CallEvent[]
    interactions          AdInteraction[]
    publications          AdPublication[] @relation("AdPublications")

    @@index([productType])
    @@index([countryCode])
    @@index([provinceCode])
    @@index([cityCode])
    @@index([armId, status])
    @@index([armId, categoryId])
    @@index([armId, city])
    @@index([catalogId])
    @@index([expiresAt])
    @@index([categoryPath])
}

// ============================================================
// انتشار آگهی در بازار — AdPublication
// ------------------------------------------------------------
// اجازه می‌دهد یک آگهی به چند بازار منتشر شود.
//
// استراتژی (راه A - snapshot + deprecate):
//   - فیلدهای Ad.armId, Ad.categoryId, Ad.categoryPath به‌عنوان CACHE نگه داشته می‌شوند
//   - منبع حقیقت به AdPublication منتقل می‌شود
//   - stampCatalogAds هر دو را آپدیت می‌کند
// ============================================================

model AdPublication {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  adId            String   @db.ObjectId
  ad              Ad       @relation("AdPublications", fields: [adId], references: [id], onDelete: Cascade)

  armId           String   @db.ObjectId
  arm             Arm      @relation("ArmAdPublications", fields: [armId], references: [id], onDelete: Cascade)

  catalogId       String   @db.ObjectId

  categoryId      String?
  categoryPath    String[] @default([])

  status          String   @default("published")
  rejectionReason String?

  publishedAt     DateTime @default(now())
  publishedBy     String?  @db.ObjectId
  unpublishedAt   DateTime?
  updatedAt       DateTime @updatedAt

  @@unique([adId, armId])
  @@index([armId, status])
  @@index([armId, categoryId])
  @@index([catalogId])
  @@index([adId, status])
  @@map("ad_publications")
}

model BuyLead {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  armId           String   @db.ObjectId
  arm             Arm      @relation(fields: [armId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  catalogId      String?
  catalog        Catalog? @relation(fields: [catalogId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdByUserId String?  @db.ObjectId
  user            User?    @relation(fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categoryId      String?
  searchQuery     String
  title           String
  description     String?
  city            String
  quantityNeeded  Float?
  deadline        String
  contactMethod   String
  contactValue    String
  status          String   @default("open")
  createdAt       DateTime @default(now())
  expiresAt       DateTime?
  metadata        Json?

  @@index([armId, status])
  @@index([armId, createdAt])
}

model AdView {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  adId              String   @db.ObjectId
  ad                Ad       @relation(fields: [adId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  viewerId          String?  @db.ObjectId
  viewerAnonymousId String?
  viewedAt          DateTime @default(now())
  source            String

  @@index([adId, viewedAt])
}
// ============================================================
// 2. مدل جدید برای بازدیدها و تعاملات (Prisma)
// ============================================================


model AdInteraction {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    adId        String   @db.ObjectId
    ad          Ad       @relation(fields: [adId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    userId      String?  @db.ObjectId
    user        User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    type        String   // view, save, call, comment, share
    createdAt   DateTime @default(now())
    metadata    Json?
    ipAddress   String?
    userAgent   String?
    sessionId   String?

    @@index([adId])
    @@index([userId])
    @@index([adId, type])
   // @@unique([adId, userId, type]) // برای جلوگیری از بازدید تکراری یونیک
}

// schema.prisma - فقط این مدل اضافه شود

model CatalogInteraction {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    catalogId String   @db.ObjectId
    catalog   Catalog @relation(fields: [catalogId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    userId     String?  @db.ObjectId
    user       User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    type       String   // 'view' | 'save' | 'share'
    createdAt  DateTime @default(now())
    ipAddress  String?
    userAgent  String?
    sessionId  String?

    @@index([catalogId, type])
    @@index([userId])
    @@index([catalogId, userId, type])
}


model CallEvent {
    id                String   @id @default(auto()) @map("_id") @db.ObjectId
    adId              String   @db.ObjectId
    ad                Ad       @relation(fields: [adId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    callerId          String?  @db.ObjectId
    caller            User?    @relation(fields: [callerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
    callerAnonymousId String?
    initiatedAt       DateTime @default(now())
    returnedAt        DateTime?
    ledToDeal         Boolean?
    feedbackText      String?
    source            String?

    @@index([adId, initiatedAt])
}


// ============================================================
// لایه اقتصادی (Credit, CreditRequest, Verification)
// ============================================================

model Credit {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  user              User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  catalogId        String?  @db.ObjectId
  catalog          Catalog? @relation(fields: [catalogId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  armId             String?  @db.ObjectId
  arm               Arm?     @relation(fields: [armId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  amount            Float
  currency          String   @default("IRR")
  creditCount       Int
  pricePerCredit    Float?
  creditType        String   @default("purchased")

  // ✅ فیلد جدید
  status            String   @default("pending")  // pending, success, failed, refunded

  transactionType   String
  description       String?
  relatedEntityId   String?  @db.ObjectId
  relatedEntityType String?
  expiresAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  metadata          Json?

  @@index([userId, createdAt])
  @@index([userId, catalogId])
  @@index([armId])
  @@index([transactionType])
  @@index([creditType])
  @@index([status])  // ✅ ایندکس جدید
}

model CreditRequest {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  user          User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  catalogId    String   @db.ObjectId
  catalog      Catalog @relation(fields: [catalogId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  armId         String?  @db.ObjectId
  arm           Arm?     @relation(fields: [armId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  amount        Float
  status        String   @default("pending") // pending, approved, rejected
  receiptImage  String?
  receiptNote   String?
  verifiedBy    String?  @db.ObjectId
  verifiedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  metadata      Json?

  @@index([userId, status])
  @@index([catalogId, status])
  @@index([armId, status])
}
model TrustMetric {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  catalogId          String   @db.ObjectId
  catalog            Catalog @relation(fields: [catalogId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  armId               String?  @db.ObjectId
  arm                 Arm?     @relation(fields: [armId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trustScore          Float    @default(0)
  totalAds            Int      @default(0)
  totalViews          Int      @default(0)
  totalCalls          Int      @default(0)
  totalDealsConfirmed Int      @default(0)
  totalDisputes       Int      @default(0)
  lastCalculatedAt    DateTime @default(now())

  @@unique([catalogId, armId])
  @@index([armId, trustScore])
}
// ============================================================
// لایه فایل (File)
// ============================================================

model File {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name      String
  mimeType  String
  size      Int
  path      String
  thumbnailPath String?
  relatedModel  String?
  relatedId     String?  @db.ObjectId
  fieldKey      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  metadata       Json?    // ✅ فیلد جدید برای ذخیره s3Key و اطلاعات اضافی
  catalog  Catalog? @relation(fields: [relatedId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  arm       Arm?      @relation(fields: [relatedId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ad        Ad?       @relation(fields: [relatedId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([relatedModel, relatedId])
}

// ============================================================
// لایه صنوف (Industry) – یک صنف اصلی برای کاتالوگ
// ============================================================

// ============================================================
// لایه صنوف (Industry) – مرجع ساختاریافتهٔ صنف — فعلاً مصرف‌کننده ندارد
// (صنفِ نهاد و برچسبِ ویترین، هر دو متن آزاد هستند؛ این مدل برای فاز
//  خودکارسازی و فیلترهای ساختاریافته آینده نگه‌داری می‌شود)
// ============================================================
// ============================================================
// لایه صنوف (Industry) — مرجعِ صنف با auto-suggest
// usageCount: تعداد دفعات استفاده — برای سورت پیشنهادها (پرجستجو اول)
// ============================================================
model Industry {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String     @unique
  parentId    String?    @db.ObjectId
  parent      Industry?  @relation("IndustryTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Industry[] @relation("IndustryTree")
  level       Int        @default(0)
  path        String
  code        String?
  icon        String?
  description String?
  isActive    Boolean    @default(true)
  usageCount  Int        @default(0)   // ✅ جدید — برای سورت پیشنهادها
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@index([path])
  @@index([usageCount])
}

// ============================================================
// لایه فعالیت‌ها (Activity) – چند فعالیت برای هر کاتالوگ
// ============================================================

model Activity {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String     @unique
  parentId    String?    @db.ObjectId
  parent      Activity?  @relation("ActivityTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Activity[] @relation("ActivityTree")
  level       Int        @default(0)
  path        String
  code        String?
  icon        String?
  description String?
  isActive    Boolean    @default(true)
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  businesses  BusinessActivity[]

  @@index([parentId])
  @@index([path])
  @@index([level])
}

// ============================================================
// لایه ارتباط Catalog و Activity (many-to-many)
// ============================================================

model BusinessActivity {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  businessId  String   @db.ObjectId
  business    Business @relation("BusinessActivity", fields: [businessId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  activityId  String   @db.ObjectId
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime @default(now())

  @@unique([businessId, activityId])
  @@index([businessId])
  @@index([activityId])
}



model Setting {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    key         String
    value       Json
    scope       String   @default("system") // 'system' | 'user' | 'arm' | 'user_arm'
    scopeId     String?  // برای system: "system"، برای user: userId، برای arm: armId
    group       String?  // 'credit', 'general', 'security', 'appearance'
    description String?
    isPublic    Boolean  @default(false)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@unique([key, scope, scopeId])
    @@index([scope, scopeId])
    @@index([group])
    @@index([key])
}

model Feedback {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  armId     String?   @db.ObjectId
  arm       Arm?      @relation(fields: [armId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId    String    @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentId  String?   @db.ObjectId
  parent    Feedback? @relation("FeedbackReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Feedback[] @relation("FeedbackReplies")
  content   String
  type      String    @default("suggestion")
  status    String    @default("open")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([armId, createdAt])
  @@index([userId])
}

// ─── مدل جدید ───
model SearchLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  armId       String   @db.ObjectId
  arm         Arm      @relation(fields: [armId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userId      String?  @db.ObjectId          // null = مهمان
  user        User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  term        String                          // نرمال‌شده — همهٔ کوئری‌ها روی این
  rawTerm     String?                         // عین تایپ کاربر — فقط برای آنالیز
  resultCount Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([armId, term])        // پیشنهاددهنده: match بر اساس arm + prefix ترم
  @@index([userId, createdAt])  // تاریخچه شخصی + حذف بر اساس کاربر
  @@index([createdAt])          // پاک‌سازی دوره‌ای
  @@map("search_logs")
}